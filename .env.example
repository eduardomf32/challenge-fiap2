# Portas HTTP dos microsserviços
AUTH_PORT=8001
FLAG_PORT=8002
TARGETING_PORT=8003
EVALUATION_PORT=8004
ANALYTICS_PORT=8005

# PostgreSQL isolados por instância; flag/targeting compartilham a instância 2
AUTH_POSTGRES_PORT=5433
FLAGS_TARGETING_POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
MASTER_KEY=admin-secreto-123

# Redis
REDIS_PORT=6379

# Analytics: em modo local, SQS fica desativado e os dados usam DynamoDB Local
AWS_REGION=us-east-1
AWS_SQS_URL=
AWS_DYNAMODB_TABLE=ToggleMasterAnalytics
AWS_DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
AWS_SESSION_TOKEN=

# Preencha após gerar uma chave no auth-service; veja README.md
SERVICE_API_KEY=
